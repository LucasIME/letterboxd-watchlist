# Copy this file to `.env` and fill in your TMDB credentials.
#
# Get a free key at https://www.themoviedb.org/settings/api
# TMDB gives you two things — you only need ONE of them:
#   - "API Read Access Token" (a long v4 token, starts with eyJ...) -> put in TMDB_READ_TOKEN
#   - "API Key (v3 auth)" (a 32-char hex string)                    -> put in TMDB_API_KEY
TMDB_READ_TOKEN=
TMDB_API_KEY=

# Your Letterboxd username (the part after letterboxd.com/)
LETTERBOXD_USERNAME=lucasime

# Region for streaming availability (ISO 3166-1 country code). GB = United Kingdom.
REGION=GB
